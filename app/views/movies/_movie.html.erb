<div id="<%= dom_id movie %>">
  <div>
    <h1 class="movie-title"><%= movie.title %></h1>
  </div>

 <div>
  <strong>Rating:</strong>
  <span class="rating <%= rating_class(movie.rating) %>"><%= movie.rating %></span>
</div>

  <div>
    <strong>Description:</strong>
    <%= movie.description %>
  </div>

  <div>
    <strong>Release date:</strong>
    <%= I18n.l(movie.release_date.to_date, format: "%B %-d, %Y") if movie.release_date.present? %>
  </div>

</div>
